# Backend settings — copy to backend/.env and fill in. Never commit .env.

# ── LLM: AWS Bedrock (Converse API) ──
# Bedrock API key (bearer token) — create one in the Bedrock console under "API keys".
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-west-2
# Bedrock model / inference-profile IDs. Fast: intent, explanations, suggestions. Main: planning, SQL, repair.
LLM_MODEL_FAST=us.anthropic.claude-haiku-5-5
LLM_MODEL_MAIN=us.anthropic.claude-haiku-5-5
LLM_MAX_TOKENS=8192
# USD per million tokens, for the cost column in the developer view (Claude Haiku 5.5 list price).
LLM_INPUT_COST_PER_M=0.10
LLM_OUTPUT_COST_PER_M=0.50
# Optional: pin any pipeline step to a model, e.g. {"sql_generation": "us.anthropic.claude-sonnet-5-5"}
MODEL_ROUTES={}
# SQL generation uses the fast model when the plan's complexity score is at or below this.
SQL_FAST_MODEL_MAX_COMPLEXITY=1

# ── Test accounts ──
# Two logins for reviewers. "normal" sees chat, SQL, explanation, results, cost and validation;
# "dev" additionally sees the internals (intent, retrieval, plan, validation attempts, node trace,
# every LLM call with model / tokens / cost, prompts). The role is enforced by the API.
AUTH_NORMAL_USERNAME=demo
AUTH_NORMAL_PASSWORD=
AUTH_NORMAL_DISPLAY_NAME=Demo User
AUTH_DEV_USERNAME=developer
AUTH_DEV_PASSWORD=
AUTH_DEV_DISPLAY_NAME=Developer
# Long random string used to sign login tokens (python -c "import secrets; print(secrets.token_urlsafe(48))").
AUTH_SECRET=
AUTH_TOKEN_TTL_HOURS=12

# ── Guardrails ──
MAX_RESULT_ROWS=500
QUERY_TIMEOUT_S=5
MAX_SQL_FIX_ATTEMPTS=3
EXPORT_MAX_ROWS=50000

# ── Features ──
# "Dive deeper" follow-up suggestions (one extra fast-model call per answer, run in parallel).
SUGGESTIONS_ENABLED=true

# ── API protection (per client IP, both accounts) ──
RATE_LIMIT_PER_MINUTE=6
RATE_LIMIT_PER_DAY=60
LOGIN_ATTEMPTS_PER_MINUTE=10

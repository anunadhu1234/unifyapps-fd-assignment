# Frontend settings — copy to frontend/.env. Only VITE_* variables reach the browser: never put secrets here.

# Base URL of the backend API. Leave empty when the frontend is served by the backend
# (production) or through the Vite dev proxy below (local development).
VITE_API_BASE_URL=

# Where `npm run dev` proxies /api requests (the local uvicorn server).
VITE_DEV_PROXY_TARGET=http://localhost:8000
